<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
      Create your merchant account
    </h2>
    <p class="mt-2 text-center text-sm text-gray-600">
      Already registered?
      <%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-xl">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
      
      <%# Error Messages Display %>
      <% if @signup_form.errors.any? %>
        <div class="mb-6 rounded-md bg-red-50 p-4 border border-red-200">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(@signup_form.errors.count, "error") %> prohibited this account from being saved:
              </h3>
              <ul class="mt-2 list-disc list-inside text-sm text-red-700">
                <% @signup_form.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with model: @signup_form, url: user_registration_path, method: :post, class: "space-y-6" do |f| %>
        
        <%# Merchant Section %>
        <div class="border-b border-gray-200 pb-4">
          <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Business Details</h3>
          <div>
            <%= f.label :merchant_name, "Business / Merchant Name", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= f.text_field :merchant_name, autofocus: true, required: true, 
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
            </div>
          </div>
        </div>

        <%# Owner User Section %>
        <div>
          <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Account Owner Information</h3>
          
          <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4">
            <div>
              <%= f.label :first_name, class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= f.text_field :first_name, required: true,
                    class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
              </div>
            </div>

            <div>
              <%= f.label :last_name, class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= f.text_field :last_name, required: true,
                    class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= f.email_field :email, autocomplete: "email", required: true,
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4 mt-4">
            <div>
              <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= f.password_field :password, autocomplete: "new-password", required: true,
                    class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
              </div>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                    class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
              </div>
            </div>
          </div>
        </div>

        <div>
          <%= f.submit "Create Account & Merchant", 
              class: "flex w-full justify-center rounded-md border border-transparent bg-indigo-600 py-2.5 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer" %>
        </div>
      <% end %>

    </div>
  </div>
</div>