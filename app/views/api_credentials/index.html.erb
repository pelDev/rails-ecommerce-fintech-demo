<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="modal">
  
  <%# Header & Action Button %>
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">API Credentials</h1>
      <p class="text-sm text-gray-500">Manage custom key and secret pairs used for API authentication.</p>
    </div>
    <div class="mt-4 md:mt-0">
      <%= button_to api_credentials_path, method: :post, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Generate New Key Pair
      <% end %>
    </div>
  </div>

  <%# One-Time Raw Secret Alert Modal (Only shown right after generation) %>
  <% if flash[:raw_secret].present? %>
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-[10]" aria-hidden="true"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen z-[10]" aria-hidden="true">&#8203;</span>

        <!-- Modal Card -->
        <div class="relative z-[20] inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
          <div class="sm:flex sm:items-start">
            <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 sm:mx-0 sm:h-10 sm:w-10">
              <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
              <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                Save Your API Secret
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500">
                  This secret key will <strong>never be shown again</strong>. Please copy and store it securely in your secrets manager.
                </p>

                <div class="mt-4 bg-gray-50 p-3 rounded-md border border-gray-200 font-mono text-xs space-y-2">
                  <div>
                    <span class="text-gray-400 block uppercase font-sans text-[10px]">API Key:</span>
                    <span class="text-gray-800 break-all select-all"><%= flash[:new_key] %></span>
                  </div>
                  <div class="pt-2 border-t border-gray-200">
                    <span class="text-gray-400 block uppercase font-sans text-[10px]">API Secret:</span>
                    <span class="text-red-600 font-semibold break-all select-all"><%= flash[:raw_secret] %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
            <%= link_to "I Have Saved My Secret", api_credentials_path, class: "w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:ml-3 sm:w-auto sm:text-sm cursor-pointer" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# API Credentials Table %>
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Key Reference</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
          <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @api_credentials.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-500">
              No API credentials found. Click "Generate New Key Pair" above to create your first set of keys.
            </td>
          </tr>
        <% else %>
          <% @api_credentials.each do |credential| %>
            <tr>
              <!-- Key -->
              <td class="px-6 py-4 whitespace-nowrap font-mono text-xs text-gray-900 font-medium">
                <%= credential.key %>
              </td>

              <!-- Status Badge -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if credential.active? %>
                  <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Active
                  </span>
                <% else %>
                  <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Revoked
                  </span>
                <% end %>
              </td>

              <!-- Created At -->
              <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                <%= credential.created_at.strftime("%b %d, %Y %H:%M") %>
              </td>

              <!-- Expires At -->
              <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                <%= credential.expires_at.strftime("%b %d, %Y") %>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 whitespace-nowrap text-right text-xs font-medium">
                <% if credential.active? %>
                  <%= button_to "Revoke", api_credential_path(credential), 
                      method: :delete,
                      form: { data: { turbo_confirm: "Are you sure you want to revoke this API credential? Any client using this key will immediately lose API access." } },
                      class: "text-red-600 hover:text-red-900 font-semibold cursor-pointer" %>
                <% else %>
                  <span class="text-gray-400 italic">Revoked</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>