<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      
      <!-- Left side: Brand & Nav Links -->
      <div class="flex">
        <!-- Logo / Brand -->
        <div class="flex-shrink-0 flex items-center">
          <%= link_to dashboard_path, class: "text-xl font-bold text-indigo-600 flex items-center gap-2" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>PayEngine</span>
          <% end %>
        </div>

        <!-- Navigation Links -->
        <div class="hidden sm:ml-8 sm:flex sm:space-x-4 items-center">
          <%= link_to "Dashboard", dashboard_path, 
              class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(dashboard_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" %>
        
          <%= link_to "API Credentials", api_credentials_path, 
              class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(api_credentials_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" %>
        
          <%= link_to "Test Console", new_order_path, 
              class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(new_order_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" %>
        </div>
      </div>

      <!-- Right side: User Profile & Logout -->
      <div class="flex items-center gap-4">
        <div class="text-xs text-right hidden md:block">
          <p class="font-semibold text-gray-900"><%= current_user.first_name %> <%= current_user.last_name %></p>
          <p class="text-gray-500 font-mono"><%= current_user.merchant.name %></p>
        </div>

        <!-- Devise Logout Button (Uses Turbo data-turbo-method) -->
        <%= button_to destroy_user_session_path, 
            method: :delete, 
            form: { data: { turbo: true } }, 
            class: "inline-flex items-center justify-center px-3.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" do %>
          <svg class="w-4 h-4 mr-1.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sign Out
        <% end %>
      </div>

    </div>
  </div>
</nav>