<%# Subscribe to real-time events for current merchant %>
<%= turbo_stream_from "merchant_#{current_user.merchant_id}_test_console" %>


<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="test-console">
  

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Order & Payment Test Console</h1>
    <p class="text-sm text-gray-500">Simulate API integration payloads against host endpoints directly using client keys.</p>
  </div>

  <!-- API Credentials Configuration -->
  <div class="bg-indigo-900 text-white p-6 rounded-lg shadow-sm mb-6">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-200 mb-4">Client API Credentials</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium text-indigo-100">API Key (X-Api-Key)</label>
        <input type="text" data-test-console-target="apiKey" placeholder="pk_live_..." 
          class="mt-1 block w-full rounded-md border-0 bg-indigo-800 text-white placeholder-indigo-400 p-2 text-xs font-mono focus:ring-2 focus:ring-indigo-400">
      </div>
      <div>
        <label class="block text-xs font-medium text-indigo-100">API Secret (X-Api-Secret)</label>
        <input type="password" data-test-console-target="apiSecret" placeholder="sk_live_..." 
          class="mt-1 block w-full rounded-md border-0 bg-indigo-800 text-white placeholder-indigo-400 p-2 text-xs font-mono focus:ring-2 focus:ring-indigo-400">
      </div>
    </div>
  </div>

  <!-- Real-Time Event Listener Box -->
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
    <h3 class="text-sm font-bold text-gray-900 mb-2">Real-Time Event Feed (`notify_merchant`)</h3>
    <p class="text-xs text-gray-500 mb-4">Listening via ActionCable stream. Will be replaced by webhook delivery service in production.</p>

    <!-- This element is replaced dynamically via Turbo Stream broadcast -->
    <div id="payment_status_badge" class="p-4 rounded-md border border-dashed border-gray-300 text-xs font-mono text-gray-400 text-center">
      Awaiting payment events...
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- STEP 1: CREATE ORDER -->
    <div class="space-y-6">
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h2 class="text-lg font-bold text-gray-900 mb-1">1. Create Order Payload</h2>
        <p class="text-xs text-gray-500 mb-4">Executes <code class="bg-gray-100 px-1 py-0.5 rounded">OrderCreationForm</code> validation & persistence.</p>

        <form data-action="submit->test-console#createOrder" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700">Currency</label>
              <select data-test-console-target="currency" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2">
                <% %w[USD EUR GBP JPY CAD AUD CHF ZAR].each do |curr| %>
                  <option value="<%= curr %>"><%= curr %></option>
                <% end %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700">External Reference</label>
              <input type="text" data-test-console-target="extRef" placeholder="Auto-generated if empty" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2">
            </div>
          </div>

          <!-- Order Items Builder -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label class="block text-xs font-medium text-gray-700">Order Line Items</label>
              <button type="button" data-action="click->test-console#addOrderItem" class="text-xs text-indigo-600 font-semibold hover:underline">+ Add Item</button>
            </div>
            <div data-test-console-target="itemsContainer"></div>
          </div>

          <button type="submit" class="w-full bg-indigo-600 text-white text-xs font-bold py-2.5 px-4 rounded-md hover:bg-indigo-700 cursor-pointer">
            POST /api/v1/orders
          </button>
        </form>
      </div>

      <!-- Order Response Output -->
      <div class="bg-gray-900 text-green-400 p-4 rounded-lg shadow-sm border border-gray-800">
        <div class="text-[10px] uppercase font-mono text-gray-500 mb-1">Order API Response JSON</div>
        <pre data-test-console-target="orderResponse" class="text-xs font-mono overflow-x-auto h-44">{ "status": "awaiting execution" }</pre>
      </div>
    </div>

    <!-- STEP 2: INITIATE PAYMENT -->
    <div class="space-y-6">
      <div data-test-console-target="paymentConsole" class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 hidden">
        <h2 class="text-lg font-bold text-gray-900 mb-1">2. Initiate Payment</h2>
        <p class="text-xs text-gray-500 mb-4">Executes <code class="bg-gray-100 px-1 py-0.5 rounded">PaymentInitiationService</code> for the created order.</p>

        <form data-action="submit->test-console#initiatePayment" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700">Amount (Cents)</label>
              <input type="number" data-test-console-target="paymentAmount" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2 bg-gray-50" readonly>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700">Currency</label>
              <input type="text" data-test-console-target="paymentCurrency" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2 bg-gray-50" readonly>
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-gray-700">Payment Method</label>
            <select data-test-console-target="paymentMethod" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2">
              <option value="card">Credit / Debit Card</option>
              <option value="bank_transfer">Bank Transfer</option>
              <option value="nfc_card">NFC Card Swipe</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-gray-700">Idempotency Key</label>
            <input type="text" data-test-console-target="idempotencyKey" class="mt-1 block w-full text-xs rounded-md border-gray-300 border p-2 font-mono">
          </div>

          <button type="submit" class="w-full bg-emerald-600 text-white text-xs font-bold py-2.5 px-4 rounded-md hover:bg-emerald-700 cursor-pointer">
            POST /api/v1/orders/:id/payments
          </button>
        </form>
      </div>

      <!-- Payment Response Output -->
      <div class="bg-gray-900 text-green-400 p-4 rounded-lg shadow-sm border border-gray-800">
        <div class="text-[10px] uppercase font-mono text-gray-500 mb-1">Payment API Response JSON</div>
        <pre data-test-console-target="paymentResponse" class="text-xs font-mono overflow-x-auto h-44">{ "status": "awaiting order creation step" }</pre>
      </div>
    </div>

  </div>
</div>